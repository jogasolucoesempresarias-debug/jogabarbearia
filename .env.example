# JOGA Barbearia — template de variáveis de ambiente
# Copie pra `.env` (local) ou cadastre no Portainer (prod). NUNCA commitar o `.env`.

# ── Flask ──
SECRET_KEY=troque-essa-chave-em-prod

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=joga_barbearia
DB_USER=postgres
DB_PASSWORD=

# ── Senha inicial dos usuários semeados (trocada no 1º login) ──
SEED_SENHA_INICIAL=joga123

# ── Alerta de WhatsApp quando o cliente ENVIA a ficha (UazAPI) ──
# ALERTAS_ATIVO é a trava mestra: vazio/0 = não dispara nada (dev e testes ficam quietos).
ALERTAS_ATIVO=
UAZAPI_URL=https://free.uazapi.com
UAZAPI_TOKEN=
# Quem recebe o aviso, separado por vírgula (Gabriel, João)
ALERTA_WHATSAPP=34999434613,28999850221

# ── Hub de coleta (só na instância coletabarbearia.jogasolucoes.com.br) ──
# 1 = a instância NÃO é barbearia: guarda N fichas de prospect e o "aplicar" fica bloqueado.
# Vazio/ausente = instância normal de barbearia (o padrão).
MODO_COLETA=

# ── Instância de demonstração (demobarbearia.jogasolucoes.com.br) ──
# 1 = mostra as credenciais na tela de login, fecha o /setup e libera o seed_demo.py.
# O seed APAGA TUDO e se recusa a rodar sem isto — é a trava que protege a instância de cliente.
MODO_DEMO=

# ── Acesso de SUPORTE/MASTER (JOGA) — invisível pro cliente ──
# Login mestre que NÃO fica no banco. Funciona só se estas duas estiverem preenchidas.
# Use um e-mail não óbvio e uma senha forte. Deixe VAZIO pra desativar.
SUPORTE_EMAIL=
SUPORTE_SENHA=
